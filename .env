# ═══════════════════════════════════════════════
#  💚 SABA MD — ENVIRONMENT VARIABLES
#  👨‍💻 Made by Arslan Tech's for Saba
#  ⚠️  NEVER commit this file to GitHub!
# ═══════════════════════════════════════════════

# ─── BOT IDENTITY ───
BOT_NAME=Saba MD
VERSION=1.0.0
PREFIX=.

# ─── ANTIDELETE ───
# true = DMs mein bhi antidelete on (default: groups mein hi on)
ANTIDELETE_DM=false

# ─── OWNER ───
# Multiple owners? Comma se separate karo: 92300...,92300...
OWNER_NAME=Saba
OWNER_NUMBER=923001234567

# ─── SESSION ───
SESSION_NAME=session

# ─── PAIRING ───
# true  = public website se koi bhi pair kar sakta
# false = sirf PAIRING_NUMBER pair hoga
PUBLIC_PAIRING=true

# Agar PUBLIC_PAIRING=false ho to yeh number use hoga
PAIRING_NUMBER=

# ─── ANTI-CALL ───
# true = calls reject honge
ANTI_CALL=false

# true = reject ke saath caller block bhi hoga
AUTO_BLOCK_CALL=false

# ─── WEBSITE ───
PORT=3000

# ─── TIMEZONE ───
# Pakistan: Asia/Karachi
# India:    Asia/Kolkata
# Dubai:    Asia/Dubai
TZ=Asia/Karachi

# ═══════════════════════════════════════════════
#  🔑 API KEYS
# ═══════════════════════════════════════════════

# ─── UNSPLASH (Wallpapers) ───
# Get from: https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=eS_6oT7X9R9GbPogdaISk2_rC4nM1wK7vhZsnk0RKWI

# ─── AI APIs (future ke liye — abhi khaali chhodo) ───
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── WEATHER (tools.js ke liye) ───
WEATHER_API_KEY=

# ─── CUSTOM APIS ───
# Agar koi custom API use karo to yahan daalo
CUSTOM_API_KEY=
CUSTOM_API_URL=

# ═══════════════════════════════════════════════
#  ⚠️  IMPORTANT NOTES
# ═══════════════════════════════════════════════
# 1. Yeh file GitHub pe push NAHI hoti (.gitignore)
# 2. Token kabhi kisi ko mat do
# 3. Token leak ho jaye to turant regenerate karo
# 4. Render/Railway/VPS pe environment variables
